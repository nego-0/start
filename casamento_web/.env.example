# ============================================================
# .env.example — Variáveis de ambiente da plataforma de convites
#
# COPIE este ficheiro para fora do repositório e defina os valores no seu
# alojamento (painel do host, ficheiro .env do servidor, variáveis do
# systemd/Docker, etc.). O config.php lê estas variáveis; quando não estão
# definidas, usa os valores por defeito (só adequados a testes locais).
#
# NUNCA guarde segredos reais dentro do repositório.
# ============================================================

# ---- Acesso (senhas) ---------------------------------------
# RECOMENDADO: guarde um HASH, não a senha em texto.
# Gere-o com:  php gerar-hash.php "a-sua-senha"
CW_SENHA_ADMIN=
CW_SENHA_PORTEIRO=

# ---- Base de dados (produção) ------------------------------
# CW_DB_MODE: auto (tenta local e depois online), online (só produção) ou local.
CW_DB_MODE=online
CW_DB_HOST=
CW_DB_USER=
CW_DB_PASS=
CW_DB_NAME=

# ---- Base de dados (testes locais, opcional) ---------------
# CW_DB_LOCAL_HOST=localhost
# CW_DB_LOCAL_USER=root
# CW_DB_LOCAL_PASS=
# CW_DB_LOCAL_NAME=wedding_guests

# ---- Site ---------------------------------------------------
# URL base explícito (recomendado atrás de proxy/CDN) para links e QR corretos.
# Ex.: https://convites.oseudominio.pt
CW_BASE_URL=

# Fuso horário (nomes IANA). Ex.: Africa/Luanda, Europe/Lisbon.
CW_TZ=Africa/Luanda

# ---- Evento inicial (semente — opcional) -------------------
# CW_NOIVA=Isabel
# CW_NOIVO=Abednego
# CW_DATA_ISO=2026-12-19
# CW_DATA_EXT=19 de Dezembro de 2026
# CW_HORA=16:00
# CW_LOCAL=Estufa Municipal de Moçâmedes
# CW_CIDADE=Namibe, Angola
# CW_WHATSAPP=244000000000

# ---- Regras (opcional) -------------------------------------
# CW_MAX_LUGARES=300
